# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase anonymous key
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Your Supabase service role key (for admin actions)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# DATABASE_URL: Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.tdhbgwrbqagdgydhwdcd:[YOUR-PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.tdhbgwrbqagdgydhwdcd:[YOUR-PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:5432/postgres"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
